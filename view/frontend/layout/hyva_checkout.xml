        <script src="https://unpkg.com/@dintero/checkout-web-sdk@0.8.0/dist/dintero-checkout-web-sdk.umd.min.js" src_type="url" />
    </head>
    <body>
        <referenceContainer name="magewire.plugin.scripts">
            <block
